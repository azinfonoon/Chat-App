
@model EditModelDto
<section class="page-section narrow">
    <div class="section-header">
        <h1>Edit Message</h1>
        <p class="muted">Update your message. On success, an "edited" badge should show in list.</p>
    </div>

    <!-- Sample static prefilled form. Replace values with Model fields -->
    <form method="post" asp-controller="message" asp-action="Edit" asp-route-id="@Model.Id" class="form-card">
        <label class="form-label">
            Your name
            <input asp-for="UserName" type="text" class="input"  required />
        </label>

        <label class="form-label">
            Message
            <textarea asp-for="Text" class="input input-text" rows="6"
                      required>.</textarea>
        </label>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-ghost" asp-controller="message" asp-action="index">Back</a>
        </div>
    </form>
</section>
